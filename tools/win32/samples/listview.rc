#include <windows.h>
#include <commctrl.h>
1 DIALOGEX 0, 0, 240, 130
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "List view"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 100, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 7, 226, 96
    DEFPUSHBUTTON "OK", IDOK, 183, 109, 50, 14
END
