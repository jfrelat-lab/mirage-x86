#include <windows.h>
1 DIALOGEX 0, 0, 260, 190
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Controls"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Options", 100, 7, 7, 120, 70
    AUTOCHECKBOX    "Checked", 101, 14, 20, 100, 10
    AUTOCHECKBOX    "Not checked", 102, 14, 33, 100, 10
    AUTORADIOBUTTON "Radio one", 103, 14, 46, 100, 10, WS_GROUP
    AUTORADIOBUTTON "Radio two", 104, 14, 59, 100, 10
    LTEXT           "Name:", 105, 135, 9, 40, 8
    EDITTEXT        106, 135, 19, 118, 14, ES_AUTOHSCROLL
    EDITTEXT        107, 135, 37, 118, 40, ES_MULTILINE | WS_VSCROLL
    LISTBOX         108, 7, 84, 120, 50, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        109, 135, 84, 118, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Left", 110, 135, 104, 118, 8
    CTEXT           "Centred", 111, 135, 114, 118, 8
    RTEXT           "Right", 112, 135, 124, 118, 8
    DEFPUSHBUTTON   "OK", IDOK, 89, 168, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 145, 168, 50, 14
    PUSHBUTTON      "Disabled", 113, 203, 168, 50, 14, WS_DISABLED
END
