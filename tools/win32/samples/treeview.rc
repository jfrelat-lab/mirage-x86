#include <windows.h>
#include <commctrl.h>
1 DIALOGEX 0, 0, 180, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Tree view"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 100, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 166, 115
    DEFPUSHBUTTON "OK", IDOK, 123, 129, 50, 14
END
