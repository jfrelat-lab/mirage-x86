{
  "oasis": 1,
  "title": "id's X11 DOOM built and played in MIRAGE-LINUX \u2014 gcc 2.7.2 and XFree86 3.3 of 1997",
  "year": 1997,
  "author": "id Software, the XFree86 Project, the Debian project, busybox",
  "thumb": "oasis/thumbs/linux-doom-x11.png",
  "world": "linux",
  "machine": {
    "cpu": "686",
    "mem": 64,
    "vga": "cirrus"
  },
  "layers": [
    {
      "busybox": "https://busybox.net/downloads/binaries/1.35.0-i686-linux-musl/busybox"
