{
  "oasis": 1,
  "title": "Quake for X11 (id Software, October 1997) — in a window on XFree86 3.3",
  "year": 1997,
  "author": "id Software, port by Dave 'Zoid' Kirsch; The XFree86 Project, the Debian project",
  "world": "linux",
  "thumb": "oasis/thumbs/linux-quake-x11-1997.png",
  "machine": {
    "cpu": "686",
    "mem": 64,
    "vga": "cirrus",
    "hz": 100
  },
  "layers": [
    {
      "busybox": "https://busybox.net/downloads/binaries/1.35.0-i686-linux-musl/busybox"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/libc5_5.4.33-6.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ldso_1.8.12-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xlib6_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xext_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xserver-svga_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xfntbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses3.0_1.9.9e-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses-base_1.9.9e-1.deb"
    },
    {
      "file": "oasis/files/XF86Config-cirrus",
      "to": "/etc/X11/XF86Config"
    },
    {
      "file": "oasis/files/ld.so.conf-x11",
      "to": "/etc/ld.so.conf"
    },
    {
      "file": "oasis/files/twmrc-doom",
      "to": "/root/.twmrc"
    },
    {
      "tar": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/unsup/unix/quake.x11-1.0-i386-unknown-linux2.0.tar.gz",
      "into": "usr/games/quake"
    },
    {
      "zip": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/quake/quake106.zip",
      "lha": "resource.1",
      "into": "usr/games/quake",
      "files": {
        "ID1/PAK0.PAK": "id1/pak0.pak"
      }
    },
    {
      "links": {
        "/lib/ld-linux.so.1": "ld-linux.so.1.8.12",
        "/sbin/ldconfig": "ldconfig.new",
        "/lib/libdl.so.1": "libdl.so.1.8.12"
      }
    },
    {
      "mkdir": [
        "/tmp",
        "/tmp/.X11-unix",
        "/root"
      ]
    },
    {
      "file": "oasis/files/passwd",
      "to": "/etc/passwd"
    },
    {
      "file": "oasis/files/group",
      "to": "/etc/group"
    },
    {
      "file": "oasis/files/utmp",
      "to": "/var/run/utmp"
    },
    {
      "run": "ldconfig",
      "cwd": "/"
    }
  ],
  "entry": {
    "run": "/bin/sh",
    "cwd": "/usr/games/quake",
    "console": true,
    "env": {
      "HOME": "/root",
      "TERM": "linux",
      "PATH": "/usr/X11R6/bin:/usr/bin:/bin:/sbin"
    },
    "args": [
      "-c",
      "XF86_SVGA :0 >/tmp/X.log 2>&1 & until [ -e /tmp/.X11-unix/X0 ]; do :; done; export DISPLAY=:0; twm & exec ./quake.x11 -winsize 640 400 -nocdaudio -noudp"
    ]
  },
  "output": "window",
  "notes": "id's quake.x11 1.0 (libc5, Xlib and the MIT-SHM extension) with Debian 1.3's libc5 and XFree86 3.3's SVGA server on MIRAGE's emulated Cirrus GD5446 at 800x600 in 256 colours, under twm, which installs Quake's colormap. The window is 640x400 (-winsize); pak0.pak is quake106.zip's shareware episode.",
  "license": "oasis/licenses/quake-shareware.txt",
  "licenseName": "id Software's shareware licence (SLICNSE.TXT, June 1996), as quake106.zip carries it",
  "caution": "Quake's shareware episode is id Software's, under its shareware licence, not a free one: it may be played and passed on whole and free of charge, with the licence, and not used commercially or displayed publicly. MIRAGE never copies it: the page fetches quake106.zip from idgames, unchanged, the licence inside it.",
  "tags": [
    "game",
    "X11",
    "Cirrus GD5446"
  ],
  "sound": true
}
