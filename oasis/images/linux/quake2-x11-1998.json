{
  "oasis": 1,
  "title": "Quake II 3.20 for Linux on X11 (ref_softx) — id Software, with the 1998 demo's data",
  "year": 1998,
  "author": "id Software, port by Dave 'Zoid' Kirsch; The XFree86 Project, the Debian project",
  "world": "linux",
  "thumb": "oasis/thumbs/linux-quake2-x11-1998.png",
  "machine": {
    "cpu": "686",
    "mem": 64,
    "vga": "cirrus",
    "hz": 100
  },
  "layers": [
    {
      "busybox": "https://busybox.net/downloads/binaries/1.35.0-i686-linux-musl/busybox"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/libc5_5.4.33-6.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ldso_1.8.12-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xlib6_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xext_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xserver-svga_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xfntbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses3.0_1.9.9e-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses-base_1.9.9e-1.deb"
    },
    {
      "file": "oasis/files/XF86Config-cirrus",
      "to": "/etc/X11/XF86Config"
    },
    {
      "file": "oasis/files/ld.so.conf-x11",
      "to": "/etc/ld.so.conf"
    },
    {
      "file": "oasis/files/twmrc-doom",
      "to": "/root/.twmrc"
    },
    {
      "tar": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/quake2/unix/quake2-3.20-i386-unknown-linux2.0.tar.gz",
      "into": "usr/games/quake2"
    },
    {
      "zip": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/quake2/q2-314-demo-x86.exe",
      "files": {
        "Install/Data/baseq2/pak0.pak": "/usr/games/quake2/baseq2/pak0.pak",
        "license.txt": "/usr/games/quake2/license.txt"
      }
    },
    {
      "file": "oasis/files/quake2.conf",
      "to": "/etc/quake2.conf"
    },
    {
      "links": {
        "/lib/ld-linux.so.1": "ld-linux.so.1.8.12",
        "/sbin/ldconfig": "ldconfig.new",
        "/lib/libdl.so.1": "libdl.so.1.8.12"
      }
    },
    {
      "mkdir": [
        "/tmp",
        "/tmp/.X11-unix",
        "/root"
      ]
    },
    {
      "file": "oasis/files/passwd",
      "to": "/etc/passwd"
    },
    {
      "file": "oasis/files/group",
      "to": "/etc/group"
    },
    {
      "file": "oasis/files/utmp",
      "to": "/var/run/utmp"
    },
    {
      "run": "ldconfig",
      "cwd": "/"
    }
  ],
  "entry": {
    "run": "/bin/sh",
    "cwd": "/usr/games/quake2",
    "console": true,
    "env": {
      "HOME": "/root",
      "TERM": "linux",
      "PATH": "/usr/X11R6/bin:/usr/bin:/bin:/sbin"
    },
    "args": [
      "-c",
      "XF86_SVGA :0 >/tmp/X.log 2>&1 & until [ -e /tmp/.X11-unix/X0 ]; do :; done; export DISPLAY=:0; twm & exec /usr/games/quake2/quake2 +set vid_ref softx +set sw_mode 1 +set cd_nocd 1"
    ]
  },
  "output": "window",
  "notes": "id's Linux Quake II 3.20 with its X11 software renderer, ref_softx.so (Xlib and MIT-SHM), in a 400x300 window (sw_mode 1) on XFree86 3.3's SVGA server, on MIRAGE's emulated Cirrus GD5446 at 800x600 in 256 colours, under twm. libc5, ld.so and X from Debian 1.3; pak0.pak from the March 1998 demo, its licence beside it.",
  "license": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/quake2/q2-314-demo-x86.exe",
  "licenseName": "id Software's Quake II demo licence (license.txt in the demo archive): free electronic redistribution with the licence",
  "caution": "The Quake II demo is id Software's, under its limited demo licence, not a free one: it may be passed on free of charge by electronic means, with its licence, for non-commercial use. MIRAGE never copies it: the page fetches id's archives unchanged.",
  "tags": [
    "game",
    "X11",
    "Cirrus GD5446"
  ],
  "sound": true
}
