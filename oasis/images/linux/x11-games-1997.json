{
  "oasis": 1,
  "title": "X11 games of 1997 \u2014 xboing, xbill, xjewel from Debian 1.3 on XFree86 3.3",
  "year": 1997,
  "author": "Justin C. Kibell (xboing), Brian Wellington and Matias Duarte (xbill), David Cooper (xjewel), the XFree86 Project, the Debian project, busybox",
  "world": "linux",
  "machine": {
    "cpu": "686",
    "mem": 64,
    "vga": "cirrus"
  },
  "layers": [
    {
      "busybox": "https://busybox.net/downloads/binaries/1.35.0-i686-linux-musl/busybox"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/libc5_5.4.33-6.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ldso_1.8.12-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xlib6_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xext_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xserver-svga_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xfntbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xfnt75_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xpm4.7_3.4g-9.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/libs/libg++27_2.7.2.1-8.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/games/xboing_2.4-6.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/games/xbill_2.0-3.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/games/xjewel_1.6-3.deb"
    },
    {
      "file": "oasis/files/XF86Config-cirrus",
      "to": "/etc/X11/XF86Config"
    },
    {
      "file": "oasis/files/ld.so.conf-x11",
      "to": "/etc/ld.so.conf"
    },
    {
      "links": {
        "/lib/ld-linux.so.1": "ld-linux.so.1.8.12",
        "/sbin/ldconfig": "ldconfig.new",
        "/lib/libdl.so.1": "libdl.so.1.8.12"
      }
    },
    {
      "mkdir": [
        "/tmp",
        "/tmp/.X11-unix",
        "/root"
      ]
    },
    {
      "file": "oasis/files/twmrc-auto",
      "to": "/root/.twmrc"
    },
    {
      "run": "ldconfig",
      "cwd": "/"
    }
  ],
  "entry": {
    "run": "/bin/sh",
    "cwd": "/root",
    "console": true,
    "env": {
      "HOME": "/root",
      "TERM": "linux",
      "PATH": "/usr/X11R6/bin:/usr/games:/usr/bin:/bin:/sbin",
      "PS1": "x11:\\w# "
    }
  },
  "output": "window",
  "notes": "Debian 1.3's X11 games on XFree86 3.3's server, on MIRAGE's emulated Cirrus GD5446 at 800x600 (the image's last layer has run ldconfig): XF86_SVGA :0 & then DISPLAY=:0 twm & and DISPLAY=:0 xboing (or xbill, xjewel).",
  "thumb": "oasis/thumbs/linux-x11-games-1997.png"
}
