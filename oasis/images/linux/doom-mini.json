{
  "oasis": 1,
  "title": "Linux DOOM 1.8 on busybox — no distribution",
  "year": 1994,
  "author": "id Software, port by Dave Taylor; busybox 1.35",
  "thumb": "oasis/thumbs/linux-doom-1994.png",
  "world": "linux",
  "machine": {
    "cpu": "686",
    "mem": 64
  },
  "layers": [
    {
      "busybox": "https://busybox.net/downloads/binaries/1.35.0-i686-linux-musl/busybox"
    },
    {
      "deb": "http://archive.debian.org/debian/dists/bo/main/binary-i386/libs/libc4_4.6.27-15.deb"
    },
    {
      "deb": "http://archive.debian.org/debian/dists/bo/main/binary-i386/base/ldso_1.8.12-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian/dists/bo/main/binary-i386/libs/aout-svgalib_1.2.10-5.deb"
    },
    {
      "tar": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/doom/linux/linuxsdoom.tar.gz",
      "into": "usr/games/doom"
    },
    {
      "gz": "https://ftp.fu-berlin.de/pc/games/idgames/idstuff/doom/doom-1.8.wad.gz",
      "to": "/usr/games/doom/doom1.wad"
    },
    {
      "links": {
        "/lib/ld.so": "ld.so.1.8.12",
        "/lib/libc.so.4": "libc.so.4.6.27",
        "/lib/libm.so.4": "libm.so.4.6.27",
        "/lib/libvga.so.1": "/usr/lib/i486-linuxaout/libvga.so.1.2.10",
        "/usr/bin/doom": "/usr/games/doom/linuxsdoom",
        "/usr/bin/sndserver": "/usr/games/doom/sndserver"
      }
    },
    {
      "mkdir": [
        "/tmp",
        "/root",
        "/etc"
      ]
    }
  ],
  "entry": {
    "run": "/bin/sh",
    "cwd": "/usr/games/doom",
    "console": true,
    "env": {
      "HOME": "/root",
      "TERM": "linux",
      "PS1": "mirage:\\w# "
    }
  },
  "output": "window",
  "notes": "A Linux with no distribution: one static busybox (its applets linked as busybox --install makes them), the three a.out libraries linuxsdoom needs, the binary and its WAD — about 4 MB, against Debian's tens. Type doom at the prompt.",
  "shelf": false
}
