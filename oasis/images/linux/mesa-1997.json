      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/graphics/glut-doc_3.3-2.deb"
    },
    {
      "file": "oasis/files/errnos.h",
      "to": "/usr/include/errnos.h"
    },
    {
      "file": "oasis/files/libnsl.a",
      "to": "/usr/lib/libnsl.a"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xext_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xserver-svga_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/x11/xfntbase_3.3-4.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses3.0_1.9.9e-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/base/ncurses-base_1.9.9e-1.deb"
    },
    {
      "file": "oasis/files/XF86Config-cirrus",
      "to": "/etc/X11/XF86Config"
    },
    {
      "file": "oasis/files/ld.so.conf-x11",
      "to": "/etc/ld.so.conf"
    },
    {
      "file": "oasis/files/twmrc-auto",
      "to": "/root/.twmrc"
    },
    {
      "links": {
        "/lib/ld-linux.so.1": "ld-linux.so.1.8.12",
        "/sbin/ldconfig": "ldconfig.new",
        "/lib/libdl.so.1": "libdl.so.1.8.12"
      }
    },
    {
      "mkdir": [
        "/tmp",
        "/tmp/.X11-unix",
        "/root"
      ]
    },
    {
      "file": "oasis/files/passwd",
      "to": "/etc/passwd"
    },
    {
      "file": "oasis/files/group",
      "to": "/etc/group"
    },
    {
      "file": "oasis/files/utmp",
      "to": "/var/run/utmp"
    },
    {
      "run": "ldconfig && mkdir -p /usr/src && cd /usr/src && tar xzf /usr/doc/glut/examples/mesademos.tar.gz && tar xzf /usr/doc/glut/examples/demos.tar.gz && cd progs/mesademos && for p in gears bounce isosurf texobj; do gcc -O2 -I/usr/X11R6/include -L/usr/X11R6/lib -o $p $p.c -lglut -lMesaGLU -lMesaGL -lXmu -lXi -lXext -lX11 -lm || exit 1; done && gcc -O2 -I/usr/X11R6/include -L/usr/X11R6/lib -o reflect reflect.c image.c -lglut -lMesaGLU -lMesaGL -lXmu -lXi -lXext -lX11 -lm && cd ../demos/atlantis && gcc -O2 -I/usr/X11R6/include -L/usr/X11R6/lib -o atlantis atlantis.c dolphin.c shark.c swim.c whale.c -lglut -lMesaGLU -lMesaGL -lXmu -lXi -lXext -lX11 -lm",
      "cwd": "/usr/src",
      "env": {
        "PATH": "/usr/X11R6/bin:/usr/bin:/bin:/sbin"
      }
    },
    {
      "file": "oasis/files/mesa-demo.sh",
      "to": "/usr/local/bin/demo"
    },
    {
      "file": "oasis/files/twmrc-mesa",
      "to": "/root/.twmrc"
    }
  ],
  "entry": {
    "run": "/bin/sh",
    "args": [
      "-c",
      "XF86_SVGA :0 >/tmp/X.log 2>&1 & until [ -e /tmp/.X11-unix/X0 ]; do :; done; export DISPLAY=:0; sh /usr/local/bin/demo gears; exec twm"
    ],
    "cwd": "/usr/src/progs/mesademos",
    "console": true,
    "env": {
      "HOME": "/root",
      "TERM": "linux",
      "PATH": "/usr/X11R6/bin:/usr/bin:/bin:/sbin",
      "PS1": "mesa:\\w# "
    }
  },
  "output": "window",
  "notes": "Mesa 2.2, Brian Paul's OpenGL in software, and GLUT 3.3 as Debian 1.3 shipped them; the image's last layer builds GLUT's Mesa demos (gears, bounce, isosurf, reflect, texobj) and the atlantis aquarium with gcc 2.7.2, once, and keeps them in the cache. The entry starts XFree86 3.3 on the emulated Cirrus GD5446, gears and twm; a click held on the desktop opens twm's menu of the demos (released on one, it replaces the one shown: two at once would share Mesa's software rasteriser) and an xterm. gears draws some 20 frames a second in its 300x300 window (100 in 5 s of real time, Mesa's software rasteriser on MIRAGE).",
  "thumb": "oasis/thumbs/linux-mesa-1997.png",
  "tags": ["OpenGL", "Mesa", "X11", "Cirrus GD5446"]
}
