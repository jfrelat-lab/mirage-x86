      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/graphics/mesa-dev_2.2-1.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/libs/glut3_3.3-2.deb"
    },
    {
      "deb": "http://archive.debian.org/debian-archive/debian/dists/bo/main/binary-i386/graphics/glut-dev_3.3-2.deb"
    },
