{
  "oasis": 1,
  "title": "OpenGL of 1997 \u2014 Mesa 2.2 and GLUT 3.3, their demos built in MIRAGE-LINUX, on XFree86 3.3",
  "year": 1997,
  "author": "Brian Paul (Mesa), Mark J. Kilgard (GLUT), Silicon Graphics (the demos), the XFree86 Project, the Debian project, busybox",
