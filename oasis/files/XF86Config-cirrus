# XF86Config for XFree86 3.3 (Debian 1.3) on MIRAGE's Cirrus Logic CL-GD5446 (machine.vga "cirrus",
# src/cirrus.js): the SVGA server's clgd5446 driver programs the chip's own registers — its clock,
# its extended CRTC bits, the banked A000 window, its hardware cursor. Without acceleration: the
# chip's BitBLT engine is not emulated. 800x600, Ctrl-Alt-Keypad+/- for 640x480. The virtual screen is
# as large as the largest mode listed: adding "1024x768" to Modes makes it 1024x768, and an 800x600
# display then pans over it, centred on the pointer — which put DOOM's window at (-112,-85).
Section "Files"
    RgbPath     "/usr/X11R6/lib/X11/rgb"
    FontPath    "/usr/X11R6/lib/X11/fonts/misc/"
EndSection

Section "ServerFlags"
EndSection

Section "Keyboard"
    Protocol    "Standard"
    AutoRepeat  500 5
EndSection

Section "Pointer"
    Protocol    "Microsoft"
    Device      "/dev/mouse"
EndSection

Section "Monitor"
    Identifier  "SVGA"
    HorizSync   31.5-50
    VertRefresh 50-90
    # VESA timings at 60 Hz.
    Modeline "640x480"   25.175  640  664  760  800   480  491  493  525
    Modeline "800x600"   40.0    800  840  968 1056   600  601  605  628 +hsync +vsync
    Modeline "1024x768"  65.0   1024 1048 1184 1344   768  771  777  806 -hsync -vsync
EndSection

Section "Device"
    Identifier  "MIRAGE Cirrus"
    Chipset     "clgd5446"
    VideoRam    4096
    Option      "noaccel"
EndSection

Section "Screen"
    Driver      "svga"
    Device      "MIRAGE Cirrus"
    Monitor     "SVGA"
    Subsection "Display"
        Depth   8
        Modes   "800x600" "640x480"
    EndSubsection
EndSection
