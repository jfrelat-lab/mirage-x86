# XF86Config for XFree86 3.3 (Debian 1.3) on MIRAGE's Cirrus Logic CL-GD5446 (machine.vga "cirrus",
# src/cirrus.js): the SVGA server's clgd5446 driver programs the chip's own registers — its clock,
# its extended CRTC bits, the banked A000 window, its hardware cursor. Without acceleration: the
# chip's BitBLT engine is not emulated. This one is XBoing's: a screen of 680x776, made for its window
# (575x741 with twm's title and border, which twm places at 50,29): the game centred, its top
# at the screen's, and nothing else around it — XBoing grabs the pointer in its window anyway.
Section "Files"
    RgbPath     "/usr/X11R6/lib/X11/rgb"
    FontPath    "/usr/X11R6/lib/X11/fonts/misc/"
    FontPath    "/usr/X11R6/lib/X11/fonts/75dpi/"    # where an image has it (xfnt75); left out otherwise
EndSection

Section "ServerFlags"
EndSection

Section "Keyboard"
    Protocol    "Standard"
    AutoRepeat  500 5
EndSection

Section "Pointer"
    Protocol    "Microsoft"
    Device      "/dev/mouse"
EndSection

Section "Monitor"
    Identifier  "SVGA"
    HorizSync   31.5-50
    VertRefresh 50-90
    # VESA timings at 60 Hz.
    Modeline "640x480"   25.175  640  664  760  800   480  491  493  525
    Modeline "800x600"   40.0    800  840  968 1056   600  601  605  628 +hsync +vsync
    Modeline "1024x768"  65.0   1024 1048 1184 1344   768  771  777  806 -hsync -vsync
    # XBoing's own: 48.3 kHz, 60 Hz.
    Modeline "680x776"   41.7    680  704  776  864   776  777  780  804
EndSection

Section "Device"
    Identifier  "MIRAGE Cirrus"
    Chipset     "clgd5446"
    VideoRam    4096
    Option      "noaccel"
EndSection

Section "Screen"
    Driver      "svga"
    Device      "MIRAGE Cirrus"
    Monitor     "SVGA"
    Subsection "Display"
        Depth   8
        Modes   "680x776"
    EndSubsection
EndSection
